{
 "format": "typed-profile-vector/v1",
 "id": "admission-record",
 "description": "The issue example: an int, a date and a list of strings in, a record out. Answers, boundaries and input refusals. An integer token with a fraction or an exponent is refused. The token -0 is the integer 0.",
 "bundle": {
  "function_id": "admission.review",
  "profile": "cel-typed/v1",
  "caller_variables": [
   "score",
   "observed_on",
   "sources"
  ],
  "limits": {
   "max_request_bytes": 4096,
   "max_string_utf8_bytes": 256,
   "max_source_utf8_bytes": 4096,
   "parser_recursion_limit": 64,
   "evaluation_cost_limit": 1000,
   "max_list_items": 4
  },
  "environment": {
   "name": "admission-review",
   "variables": [
    {
     "name": "score",
     "type": "int",
     "description": "The review score from 0 to 1000."
    },
    {
     "name": "observed_on",
     "type": "date",
     "description": "The date of the observation."
    },
    {
     "name": "sources",
     "type": "list",
     "items": "string",
     "description": "The names of the sources."
    },
    {
     "name": "min_score",
     "type": "int",
     "description": "The fixed lowest score."
    },
    {
     "name": "cutoff",
     "type": "date",
     "description": "The fixed earliest observation date."
    }
   ],
   "output": {
    "type": "record",
    "fields": [
     {
      "name": "admit",
      "type": "bool",
      "description": "True if the entry is admitted."
     },
     {
      "name": "reason",
      "type": "string",
      "description": "The reason code."
     }
    ]
   }
  },
  "source": "score >= min_score && observed_on >= cutoff && size(sources) >= 2\n  ? {'admit': true, 'reason': 'eligible'}\n  : {'admit': false, 'reason': score < min_score ? 'low_score'\n      : (observed_on < cutoff ? 'stale_observation' : 'few_sources')}\n",
  "fixed": {
   "min_score": 700,
   "cutoff": "2026-01-01"
  }
 },
 "steps": [
  {
   "name": "load",
   "op": "load",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "describe",
   "op": "describe",
   "expect": {
    "inputs": {
     "type": "object",
     "properties": {
      "score": {
       "type": "integer",
       "minimum": -9007199254740991,
       "maximum": 9007199254740991,
       "description": "The review score from 0 to 1000."
      },
      "observed_on": {
       "type": "string",
       "format": "date",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
       "description": "The date of the observation."
      },
      "sources": {
       "type": "array",
       "items": {
        "type": "string",
        "x-max-utf8-bytes": 256
       },
       "maxItems": 4,
       "description": "The names of the sources."
      }
     },
     "required": [
      "score",
      "observed_on",
      "sources"
     ],
     "additionalProperties": false
    },
    "output": {
     "type": "object",
     "properties": {
      "admit": {
       "type": "boolean",
       "description": "True if the entry is admitted."
      },
      "reason": {
       "type": "string",
       "x-max-utf8-bytes": 256,
       "description": "The reason code."
      }
     },
     "required": [
      "admit",
      "reason"
     ],
     "additionalProperties": false
    }
   }
  },
  {
   "name": "eligible",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": true,
     "reason": "eligible"
    }
   }
  },
  {
   "name": "eligible-key-order",
   "op": "run",
   "inputs_text": "{\"sources\": [\"registry\", \"survey\"], \"observed_on\": \"2026-03-14\", \"score\": 812}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": true,
     "reason": "eligible"
    }
   }
  },
  {
   "name": "low-score",
   "op": "run",
   "inputs_text": "{\"score\": 640, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": false,
     "reason": "low_score"
    }
   }
  },
  {
   "name": "boundary-score-stale-date",
   "op": "run",
   "inputs_text": "{\"score\": 700, \"observed_on\": \"2025-12-31\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": false,
     "reason": "stale_observation"
    }
   }
  },
  {
   "name": "boundary-date-one-source",
   "op": "run",
   "inputs_text": "{\"score\": 700, \"observed_on\": \"2026-01-01\", \"sources\": [\"registry\"]}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": false,
     "reason": "few_sources"
    }
   }
  },
  {
   "name": "empty-list",
   "op": "run",
   "inputs_text": "{\"score\": 900, \"observed_on\": \"2026-02-01\", \"sources\": []}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": false,
     "reason": "few_sources"
    }
   }
  },
  {
   "name": "leap-day",
   "op": "run",
   "inputs_text": "{\"score\": 900, \"observed_on\": \"2028-02-29\", \"sources\": [\"a\", \"b\", \"c\", \"d\"]}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": true,
     "reason": "eligible"
    }
   }
  },
  {
   "name": "lowest-int",
   "op": "run",
   "inputs_text": "{\"score\": -9007199254740991, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": false,
     "reason": "low_score"
    }
   }
  },
  {
   "name": "negative-zero-is-zero",
   "op": "run",
   "inputs_text": "{\"score\": -0, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "ok",
    "value": {
     "admit": false,
     "reason": "low_score"
    }
   }
  },
  {
   "name": "missing-list",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14\"}",
   "expect": {
    "status": "needs_input",
    "field": "/sources"
   }
  },
  {
   "name": "int-as-string",
   "op": "run",
   "inputs_text": "{\"score\": \"812\", \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  },
  {
   "name": "int-with-fraction",
   "op": "run",
   "inputs_text": "{\"score\": 812.0, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  },
  {
   "name": "int-with-exponent",
   "op": "run",
   "inputs_text": "{\"score\": 8.12e2, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  },
  {
   "name": "int-above-range",
   "op": "run",
   "inputs_text": "{\"score\": 9007199254740992, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  },
  {
   "name": "int-below-range",
   "op": "run",
   "inputs_text": "{\"score\": -9007199254740992, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  },
  {
   "name": "int-null",
   "op": "run",
   "inputs_text": "{\"score\": null, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  },
  {
   "name": "int-bool",
   "op": "run",
   "inputs_text": "{\"score\": true, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  },
  {
   "name": "date-short-month",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-3-14\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/observed_on"
   }
  },
  {
   "name": "date-not-in-calendar",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-02-30\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/observed_on"
   }
  },
  {
   "name": "date-not-leap-year",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-02-29\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/observed_on"
   }
  },
  {
   "name": "date-year-zero",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"0000-01-01\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/observed_on"
   }
  },
  {
   "name": "date-with-time",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14T00:00:00Z\", \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/observed_on"
   }
  },
  {
   "name": "date-as-int",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": 20260314, \"sources\": [\"registry\", \"survey\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/observed_on"
   }
  },
  {
   "name": "list-as-string",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14\", \"sources\": \"registry\"}",
   "expect": {
    "status": "invalid_input",
    "field": "/sources"
   }
  },
  {
   "name": "list-item-type",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", 7]}",
   "expect": {
    "status": "invalid_input",
    "field": "/sources/1"
   }
  },
  {
   "name": "list-item-null",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14\", \"sources\": [null]}",
   "expect": {
    "status": "invalid_input",
    "field": "/sources/0"
   }
  },
  {
   "name": "list-too-long",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14\", \"sources\": [\"a\", \"b\", \"c\", \"d\", \"e\"]}",
   "expect": {
    "status": "invalid_input",
    "field": "/sources"
   }
  },
  {
   "name": "fixed-name-as-input",
   "op": "run",
   "inputs_text": "{\"score\": 812, \"observed_on\": \"2026-03-14\", \"sources\": [\"registry\", \"survey\"], \"min_score\": 0}",
   "expect": {
    "status": "invalid_input",
    "field": "/min_score"
   }
  },
  {
   "name": "first-bad-variable",
   "op": "run",
   "inputs_text": "{\"score\": \"812\", \"observed_on\": \"2026-03-14\"}",
   "expect": {
    "status": "invalid_input",
    "field": "/score"
   }
  }
 ]
}
