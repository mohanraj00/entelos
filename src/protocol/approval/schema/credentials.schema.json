{
 "$defs": {
  "file": {
   "additionalProperties": false,
   "properties": {
    "format": {
     "const": "entelos.credentials/1"
    },
    "principals": {
     "items": {
      "additionalProperties": false,
      "properties": {
       "actor": {
        "minLength": 1,
        "type": "string"
       },
       "roles": {
        "items": {
         "enum": [
          "reviewer",
          "author",
          "runner",
          "worker",
          "caller",
          "reader",
          "observer",
          "maintainer"
         ]
        },
        "minItems": 1,
        "type": "array"
       },
       "token_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
       }
      },
      "required": [
       "actor",
       "roles",
       "token_sha256"
      ],
      "type": "object"
     },
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "format",
    "principals"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/approval/schema/credentials.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "The --credentials-file of the sidecar. Uniqueness of token_sha256 and actor is a sidecar check, not a schema keyword.",
 "title": "credentials"
}
