{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "base_snapshot": {
     "type": "string"
    },
    "bundle": {
     "additionalProperties": false,
     "properties": {
      "environment": {
       "type": "string"
      },
      "fixed": {
       "type": "string"
      },
      "manifest": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "manifest",
      "environment",
      "source",
      "fixed"
     ],
     "type": "object"
    },
    "candidate": {
     "additionalProperties": false,
     "properties": {
      "bundle": {
       "additionalProperties": false,
       "properties": {
        "environment": {
         "type": "string"
        },
        "fixed": {
         "type": "string"
        },
        "manifest": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "manifest",
        "environment",
        "source",
        "fixed"
       ],
       "type": "object"
      },
      "kind": {
       "enum": [
        "cel-bundle",
        "content"
       ]
      },
      "manifest": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    },
    "evidence": {
     "properties": {
      "format": {
       "const": "entelos.evidence/1"
      }
     },
     "required": [
      "format"
     ],
     "type": "object"
    },
    "expected_revision": {
     "type": "string"
    },
    "from": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    },
    "function": {
     "minLength": 1,
     "type": "string"
    },
    "reason": {
     "minLength": 1,
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "source_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "stale_mode": {
     "enum": [
      "fail_closed",
      "continue_stale"
     ]
    },
    "until": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    }
   },
   "required": [
    "expected_revision",
    "from",
    "reason",
    "request_key",
    "source_ref",
    "until"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "bundle_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      },
      "candidate": {
       "additionalProperties": false,
       "properties": {
        "kind": {
         "enum": [
          "cel-bundle",
          "content"
         ]
        },
        "ref": {
         "pattern": "^sha256:[0-9a-f]{64}$",
         "type": "string"
        }
       },
       "required": [
        "kind",
        "ref"
       ],
       "type": "object"
      },
      "head": {
       "additionalProperties": false,
       "properties": {
        "collection": {
         "minLength": 1,
         "type": "string"
        },
        "kind": {
         "const": "content"
        },
        "partition": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "kind",
        "collection",
        "partition"
       ],
       "type": "object"
      },
      "snapshot_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "snapshot_ref"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/approval/schema/1.3/propose.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "Protocol 1.3 propose. The body has a CEL bundle in bundle or a candidate in candidate. The Host checks the fields that each candidate kind needs.",
 "title": "propose",
 "x-entelos-access": "write",
 "x-entelos-protocol": "1.3"
}
