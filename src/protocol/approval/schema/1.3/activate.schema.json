{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "applicability": {
     "additionalProperties": {
      "additionalProperties": {
       "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "type": "object"
     },
     "type": "object"
    },
    "decision_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "expected_revision": {
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "supersedes": {
     "items": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
     },
     "type": "array"
    },
    "targets": {
     "items": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "decision_ref",
    "expected_revision",
    "request_key"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "event_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "event_ref"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/approval/schema/1.3/activate.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "Protocol 1.3 activate. The optional applicability confirms the values of the snapshot items, by item_id.",
 "title": "activate",
 "x-entelos-access": "write",
 "x-entelos-protocol": "1.3"
}
