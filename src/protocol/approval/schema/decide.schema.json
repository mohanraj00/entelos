{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "disposition": {
     "enum": [
      "accept",
      "reject"
     ]
    },
    "expected_revision": {
     "type": "string"
    },
    "reason": {
     "minLength": 1,
     "type": "string"
    },
    "report_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "expected_revision",
    "reason",
    "report_ref",
    "request_key"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "decision": {
       "properties": {
        "actor": {
         "minLength": 1,
         "type": "string"
        },
        "decided_at": {
         "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
         "type": "string"
        },
        "disposition": {
         "enum": [
          "accept",
          "reject"
         ]
        },
        "format": {
         "const": "entelos.record/1"
        },
        "from": {
         "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
         "type": "string"
        },
        "function": {
         "minLength": 1,
         "type": "string"
        },
        "reason": {
         "minLength": 1,
         "type": "string"
        },
        "report_ref": {
         "pattern": "^sha256:[0-9a-f]{64}$",
         "type": "string"
        },
        "runner_policy": {
         "minLength": 1,
         "type": "string"
        },
        "scope": {
         "minLength": 1,
         "type": "string"
        },
        "snapshot_ref": {
         "pattern": "^sha256:[0-9a-f]{64}$",
         "type": "string"
        },
        "until": {
         "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
         "type": "string"
        }
       },
       "required": [
        "actor",
        "decided_at",
        "disposition",
        "format",
        "from",
        "function",
        "reason",
        "report_ref",
        "runner_policy",
        "scope",
        "snapshot_ref",
        "until"
       ],
       "type": "object"
      },
      "decision_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "decision",
      "decision_ref"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/approval/schema/decide.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "decide",
 "x-entelos-access": "write",
 "x-entelos-protocol": "1.1"
}
