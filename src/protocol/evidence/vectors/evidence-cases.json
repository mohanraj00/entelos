{
  "format_version": 1,
  "spec": "EVIDENCE.md",
  "cases": [
    {
      "name": "valid-automatic",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": true, "inputs": {"evidence_human_reviewed": false, "evidence_model_reviewed": false, "evidence_all_automatic": true}}
    },
    {
      "name": "valid-human-review",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [
          {"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 120, "end": 188}, "admission": "automatic"},
          {"fact_id": "f-2", "receipt_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
            "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 412, "end": 460}, "admission": "reviewed",
            "review": {"outcome": "confirmed", "reviewer": "reviewer-1", "reviewer_kind": "human"}}]},
      "expect": {"valid": true, "inputs": {"evidence_human_reviewed": true, "evidence_model_reviewed": false, "evidence_all_automatic": false}}
    },
    {
      "name": "valid-model-review",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
          "source_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "span": {"start": 5, "end": 9}, "admission": "reviewed",
          "review": {"outcome": "confirmed", "reviewer": "checker.v2", "reviewer_kind": "model"}}]},
      "expect": {"valid": true, "inputs": {"evidence_human_reviewed": false, "evidence_model_reviewed": true, "evidence_all_automatic": false}}
    },
    {
      "name": "valid-human-and-model-review",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [
          {"fact_id": "f-1", "receipt_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
            "source_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "span": {"start": 5, "end": 9}, "admission": "reviewed",
            "review": {"outcome": "confirmed", "reviewer": "checker.v2", "reviewer_kind": "model"}},
          {"fact_id": "f-2", "receipt_digest": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
            "source_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "span": {"start": 9, "end": 30}, "admission": "reviewed",
            "review": {"outcome": "confirmed", "reviewer": "reviewer-1", "reviewer_kind": "human"}}]},
      "expect": {"valid": true, "inputs": {"evidence_human_reviewed": true, "evidence_model_reviewed": true, "evidence_all_automatic": false}}
    },
    {
      "name": "valid-256-facts",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": {"$repeat": {"count": 256, "fact": {"fact_id": "f-{i}", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}}}},
      "expect": {"valid": true, "inputs": {"evidence_human_reviewed": false, "evidence_model_reviewed": false, "evidence_all_automatic": true}}
    },
    {
      "name": "not-an-object",
      "evidence": [],
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "format"}
    },
    {
      "name": "format-missing",
      "evidence": {"producer": {"id": "producer-a", "version": "1.0.0"}, "facts": []},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "format"}
    },
    {
      "name": "format-not-a-string",
      "evidence": {"format": 1, "producer": {"id": "producer-a", "version": "1.0.0"}, "facts": []},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "format"}
    },
    {
      "name": "format-leading-zero",
      "evidence": {"format": "entelos.evidence/01", "producer": {"id": "producer-a", "version": "1.0.0"}, "facts": []},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "format"}
    },
    {
      "name": "format-other-name",
      "evidence": {"format": "entelos.record/1", "producer": {"id": "producer-a", "version": "1.0.0"}, "facts": []},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "format"}
    },
    {
      "name": "format-major-2",
      "evidence": {"format": "entelos.evidence/2", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "unsupported_evidence_format"}
    },
    {
      "name": "format-major-0-before-schema",
      "evidence": {"format": "entelos.evidence/0", "facts": "not a list"},
      "expect": {"valid": false, "code": "unsupported_evidence_format"}
    },
    {
      "name": "schema-producer-missing",
      "evidence": {"format": "entelos.evidence/1",
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-unknown-top-field",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"}, "signature": "x",
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-unknown-fact-field",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic", "text": "copied"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-digest-uppercase",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-digest-short",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-facts-empty",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"}, "facts": []},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-span-negative",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": -1, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-span-not-integer",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": "0", "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-admission-unknown",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "trusted"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-reviewer-kind-unknown",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "reviewed",
          "review": {"outcome": "confirmed", "reviewer": "reviewer-1", "reviewer_kind": "team"}}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "schema-name-with-space",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "schema"}
    },
    {
      "name": "too-many-facts",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": {"$repeat": {"count": 257, "fact": {"fact_id": "f-{i}", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"}}}},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "too_many_facts"}
    },
    {
      "name": "duplicate-fact",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [
          {"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic"},
          {"fact_id": "f-1", "receipt_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
            "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 1, "end": 2}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "duplicate_fact"}
    },
    {
      "name": "duplicate-fact-before-span-order",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [
          {"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 7, "end": 3}, "admission": "automatic"},
          {"fact_id": "f-1", "receipt_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
            "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 1, "end": 2}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "duplicate_fact"}
    },
    {
      "name": "span-empty",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 5, "end": 5}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "span_order"}
    },
    {
      "name": "span-reversed",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 7, "end": 3}, "admission": "automatic"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "span_order"}
    },
    {
      "name": "review-required",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "reviewed"}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "review_required"}
    },
    {
      "name": "review-forbidden",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "automatic",
          "review": {"outcome": "confirmed", "reviewer": "reviewer-1", "reviewer_kind": "human"}}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "review_forbidden"}
    },
    {
      "name": "rejected-fact",
      "evidence": {"format": "entelos.evidence/1", "producer": {"id": "producer-a", "version": "1.0.0"},
        "facts": [{"fact_id": "f-1", "receipt_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "source_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "span": {"start": 0, "end": 1}, "admission": "reviewed",
          "review": {"outcome": "rejected", "reviewer": "reviewer-1", "reviewer_kind": "human"}}]},
      "expect": {"valid": false, "code": "invalid_evidence", "rule": "rejected_fact"}
    }
  ]
}
