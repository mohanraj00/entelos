{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entelos.suspension-record",
  "title": "Suspension record of the record format entelos.record/1",
  "type": "object",
  "required": ["format", "scope", "function", "event_ref", "request_key", "from", "until", "targets", "actor"],
  "additionalProperties": false,
  "properties": {
    "format": {"type": "string", "const": "entelos.record/1"},
    "scope": {"type": "string", "minLength": 1},
    "function": {"type": "string", "minLength": 1},
    "event_ref": {"$ref": "#/$defs/ref"},
    "request_key": {"type": "string"},
    "from": {"$ref": "#/$defs/date"},
    "until": {"$ref": "#/$defs/date"},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "actor": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
