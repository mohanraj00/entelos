{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/signed/schema/keyset.schema.json",
  "title": "Public key set of one signer",
  "type": "object",
  "required": ["format", "signer", "keys"],
  "additionalProperties": false,
  "properties": {
    "format": {"type": "string"},
    "signer": {"$ref": "#/$defs/text"},
    "keys": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/key"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 256},
    "key": {
      "type": "object",
      "required": ["key_id", "algorithm", "public_key", "status"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:[0-9a-f]{64}$"},
        "algorithm": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "public_key": {"type": "string"},
        "status": {"type": "string", "enum": ["active", "retired", "revoked"]},
        "note": {"$ref": "#/$defs/text"}
      }
    }
  }
}
