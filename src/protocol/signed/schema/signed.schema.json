{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/signed/schema/signed.schema.json",
  "title": "Signed record",
  "type": "object",
  "required": ["format", "scope", "function", "record_kind", "record_ref", "record", "algorithm", "key_id", "signature"],
  "additionalProperties": false,
  "properties": {
    "format": {"type": "string"},
    "scope": {"$ref": "#/$defs/text"},
    "function": {"$ref": "#/$defs/text"},
    "record_kind": {"type": "string", "enum": ["decision", "event"]},
    "record_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record": {"type": "string", "minLength": 1, "maxLength": 1398104},
    "algorithm": {"$ref": "#/$defs/algorithm"},
    "key_id": {"$ref": "#/$defs/key_id"},
    "signature": {"type": "string"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 256},
    "algorithm": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "key_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:[0-9a-f]{64}$"}
  }
}
