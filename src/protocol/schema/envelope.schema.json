{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/envelope.schema.json",
 "title": "envelope",
 "$defs": {
  "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"},
  "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
  "request": {
   "type": "object",
   "required": ["body", "operation", "protocol", "request_id"],
   "properties": {
    "protocol": {"$ref": "#/$defs/version"},
    "request_id": {"$ref": "#/$defs/request_id"},
    "operation": {"type": "string", "minLength": 1},
    "body": {"type": "object"}
   },
   "additionalProperties": false
  },
  "diagnostic": {
   "type": "object",
   "required": ["code", "message", "stage"],
   "properties": {
    "code": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "message": {"type": "string", "maxLength": 1024}
   },
   "additionalProperties": false
  },
  "success": {
   "type": "object",
   "required": ["protocol", "request_id", "result", "status"],
   "properties": {
    "protocol": {"enum": ["1.0", "1.1"]},
    "request_id": {"$ref": "#/$defs/request_id"},
    "status": {"const": "ok"},
    "result": {}
   },
   "additionalProperties": false
  },
  "failure": {
   "type": "object",
   "required": ["diagnostic", "protocol", "request_id", "status"],
   "properties": {
    "protocol": {"enum": ["1.0", "1.1"]},
    "request_id": {"type": "string", "maxLength": 128},
    "status": {"type": "string", "minLength": 1},
    "diagnostic": {"$ref": "#/$defs/diagnostic"}
   },
   "additionalProperties": false
  }
 }
}
