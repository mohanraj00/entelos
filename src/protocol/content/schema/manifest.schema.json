{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entelos.content/1",
  "title": "Content manifest of a content proposal",
  "type": "object",
  "required": ["format", "collection", "partition", "base", "items"],
  "additionalProperties": false,
  "properties": {
    "format": {"type": "string", "const": "entelos.content/1"},
    "collection": {"$ref": "#/$defs/name"},
    "partition": {"$ref": "#/$defs/name"},
    "base": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "metadata": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 1024}},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "item": {
      "type": "object",
      "required": ["item_id", "digest", "size"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"$ref": "#/$defs/name"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{0,63}/[a-z0-9][a-z0-9.+-]{0,63}$"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["format", "digest"],
      "additionalProperties": false,
      "properties": {
        "format": {"type": "string", "const": "entelos.evidence/1"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
